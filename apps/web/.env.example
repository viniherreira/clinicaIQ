DATABASE_URL="postgresql://postgres:postgres@localhost:5432/odontoflow?schema=public"

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_COLOQUE_AQUI
CLERK_SECRET_KEY=sk_test_COLOQUE_AQUI

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=GERE_UMA_CHAVE_AQUI

REDIS_URL=redis://localhost:6379

# API oficial do WhatsApp (Cloud API): o canal de cada clinica (Meta aprovou o
# DreamClin como Tech Provider em 10/11/2026). Ver docs/specs/2026-10-11-crm-api-oficial-transmissoes-robo-design.md
# Em desenvolvimento, META_APP_SECRET e META_WEBHOOK_VERIFY_TOKEN podem ser
# quaisquer valores: os testes assinam o webhook com eles.
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# Empresa responsavel pelo servico (rodape, Politica de Privacidade, Termos).
# Dados publicos do cartao CNPJ. Sem eles, o rodape so nao mostra a linha.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_CNPJ=
NEXT_PUBLIC_COMPANY_PRIVACY_EMAIL=
NEXT_PUBLIC_COMPANY_CITY=
# WhatsApp de vendas e suporte, com DDD (ex.: 11 91234-5678). Sem ele, o site
# nao mostra o botao "Fale com a gente".
NEXT_PUBLIC_COMPANY_WHATSAPP=

# Alerta de erro: DSN do projeto no Sentry (Settings > Client Keys). Sem ele, o
# erro so vai para o log. Use um DSN para producao; deixe vazio no Preview.
NEXT_PUBLIC_SENTRY_DSN=
