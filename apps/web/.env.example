DATABASE_URL="postgresql://postgres:postgres@localhost:5432/odontoflow?schema=public"

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_COLOQUE_AQUI
CLERK_SECRET_KEY=sk_test_COLOQUE_AQUI

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=GERE_UMA_CHAVE_AQUI

REDIS_URL=redis://localhost:6379

# WhatsApp por QR code (numero proprio de cada clinica)
# Aponte para o servico apps/whatsapp-gateway. Veja docs/WHATSAPP_QRCODE.md
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=

# API oficial do WhatsApp (Cloud API) no CRM. Ficam vazias ate a Meta aprovar o
# ClinicaIQ como Tech Provider. Ver docs/superpowers/specs/2026-10-11-crm-api-oficial-transmissoes-robo-design.md
# Em desenvolvimento, META_APP_SECRET e META_WEBHOOK_VERIFY_TOKEN podem ser
# quaisquer valores: os testes assinam o webhook com eles.
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
