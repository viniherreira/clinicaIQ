# Variáveis só dos testes E2E. Copie para apps/web/.env.test e preencha.
# O resto (banco, chaves do Clerk, chave de criptografia) vem do .env.local.

# E-mail da conta de teste criada no Clerk de DESENVOLVIMENTO.
# Precisa ter "+clerk_test" antes do @ — é o que marca a conta como de teste.
# Não precisa de senha: o login dos testes usa a CLERK_SECRET_KEY.
E2E_CLERK_USER_EMAIL=seu-nome+clerk_test@exemplo.com
