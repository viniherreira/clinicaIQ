generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooler (Supabase Transaction mode, port 6543) — used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct/session connection (port 5432) — used by `prisma db push`/migrations.
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  RECEPTIONIST
  PROFESSIONAL
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  ATTENDED
  MISSED
}

enum AppointmentType {
  PARTICULAR
  CONVENIO
  CORTESIA
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ToothStatus {
  TO_TREAT
  IN_TREATMENT
  TREATED
  EXTRACTED
  MISSING
}

// ─── Models ──────────────────────────────────────────────

model Tenant {
  id         String   @id @default(cuid())
  clerkOrgId String   @unique
  name       String
  slug       String   @unique
  document   String?
  phone      String?
  email      String?
  /// Endereço em uma linha, montado a partir dos campos abaixo ao salvar.
  /// Existe porque é o que o PDF do orçamento lê — manter a composição aqui
  /// evita que a geração do PDF precise saber como se escreve um endereço.
  address    String?
  zipCode       String?
  street        String?
  addressNumber String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  /// Caminho do logotipo no storage privado (não é URL pública). Os PDFs
  /// baixam os bytes no servidor; a tela de configurações assina um link curto.
  logoUrl    String?

  /// Responsável técnico e o registro dele no conselho (ex.: "CRO-SP 12345").
  /// O conselho exige os dois nos documentos da clínica — saem no rodapé de
  /// assinatura do orçamento, do recibo e do contrato.
  technicalResponsible  String?
  technicalRegistration String?
  /// Condições gerais impressas no fim de todo orçamento. Nulo = texto padrão.
  quoteTerms            String?
  /// Cláusulas próprias da clínica, acrescentadas ao contrato padrão.
  contractTerms         String?

  settings   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users               User[]
  patients            Patient[]
  professionals       Professional[]
  procedures          Procedure[]
  procedureCategories ProcedureCategory[]
  appointments        Appointment[]
  quotes              Quote[]
  messages            WhatsAppMessage[]
  auditLogs           AuditLog[]
  blockedSlots        BlockedSlot[]
  patientNotes        PatientNote[]
  toothRecords        ToothRecord[]
  payments            Payment[]
  anamneses           Anamnesis[]
  evolutions          Evolution[]
  patientFiles        PatientFile[]
  whatsappSession     WhatsAppSession?
  campaigns           Campaign[]
  subscription        Subscription?
  invitations         Invitation[]

  // CRM (etapa 1)
  leads               Lead[]
  pipelineStages      PipelineStage[]
  leadTasks           LeadTask[]
  leadTags            LeadTag[]
  leadTagOnLeads      LeadTagOnLead[]
  lostReasons         LostReason[]
  leadActivities      LeadActivity[]

  // CRM (etapa 2)
  conversations       Conversation[]
  chatMessages        ChatMessage[]
  quickReplies        QuickReply[]

  // CRM (API oficial, transmissões, robô e automações)
  whatsappCloudAccount WhatsAppCloudAccount?
  messageTemplates     MessageTemplate[]
  broadcasts           Broadcast[]
  broadcastRecipients  BroadcastRecipient[]
  stageAutomations     StageAutomation[]
  automationRuns       AutomationRun[]
  chatbotFlows         ChatbotFlow[]

  @@map("tenants")
}

model User {
  id String @id @default(cuid())

  tenantId String

  /// Conta do Clerk ligada a este acesso.
  ///
  /// Fica nulo quando a pessoa é removida da equipe: `clerkUserId` é único no
  /// banco inteiro, então segurá-lo numa linha desativada impediria a mesma
  /// pessoa de voltar — e voltar tem que ser possível, é o fluxo normal de quem
  /// sai e é recontratado.
  clerkUserId String? @unique

  /// A conta que estava aqui antes da remoção. Só para auditoria: responde
  /// "era a mesma pessoa?" quando alguém é reconvidado meses depois.
  previousClerkUserId String?

  name   String
  email  String
  role   Role    @default(RECEPTIONIST)
  /// Tem acesso ao CRM e conta na cobrança do adicional (R$ por usuário).
  crmSeat Boolean @default(false)
  /// Bandeira operacional: é ela que todas as consultas filtram.
  /// `deactivatedAt` é o registro do fato; as duas são escritas juntas.
  active Boolean @default(true)

  /// Quando o acesso foi encerrado, por quem e por quê. Nulo enquanto ativo.
  deactivatedAt      DateTime?
  deactivatedById    String?
  deactivationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  patientNotes PatientNote[]
  auditLogs    AuditLog[]
  assignedLeads Lead[]     @relation("LeadAssignee")
  assignedTasks LeadTask[] @relation("LeadTaskAssignee")
  chatMessagesSent ChatMessage[]

  @@index([tenantId])
  @@index([tenantId, deactivatedAt])
  @@map("users")
}

model Patient {
  id              String    @id @default(cuid())
  tenantId        String
  controlNumber   Int
  name            String
  nickname        String?
  cpfEncrypted    String?   @map("cpf")
  phoneEncrypted  String    @map("phone")
  phone2Encrypted String?   @map("phone2")
  email           String?
  birthDate       DateTime?
  gender          String?
  maritalStatus   String?
  profession      String?
  referredBy      String?
  notes           String?
  zipCode         String?
  street          String?
  addressNumber   String?
  complement      String?
  neighborhood    String?
  city            String?
  state           String?
  /// Aceite do tratamento dos dados para o atendimento. Obrigatório no cadastro.
  lgpdConsentAt   DateTime?
  /// Aceite separado para receber campanha promocional. Nulo = nunca autorizou.
  ///
  /// Separado do `lgpdConsentAt` de propósito: aquele cobre tratar o paciente e
  /// guardar o prontuário, que tem base legal própria e não depende de
  /// autorização. Disparo promocional em massa é outra finalidade e precisa de
  /// aceite específico — e é também o que a política do WhatsApp exige para o
  /// número não ser derrubado por denúncia.
  marketingConsentAt DateTime?
  /// Patient asked to stop receiving campaigns (replied SAIR/PARAR).
  whatsappOptOut  Boolean   @default(false)
  active          Boolean   @default(true)
  deletedAt       DateTime?
  createdById     String?
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  patientNotes PatientNote[]
  appointments Appointment[]
  quotes       Quote[]
  messages     WhatsAppMessage[]
  toothRecords ToothRecord[]
  payments     Payment[]
  anamnesis    Anamnesis?
  evolutions   Evolution[]
  files        PatientFile[]
  campaignRecipients CampaignRecipient[]
  leads              Lead[]
  conversations      Conversation[]

  @@unique([tenantId, controlNumber])
  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, deletedAt])
  @@map("patients")
}

model PatientNote {
  id        String   @id @default(cuid())
  tenantId  String
  patientId String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([patientId, createdAt(sort: Desc)])
  @@map("patient_notes")
}

model Professional {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?  @unique
  name      String
  specialty String?
  /// Registro no conselho de classe (ex.: "CRO-SP 12345"). Sai nos documentos
  /// em que este profissional é o responsável pelo tratamento.
  registration String?
  color     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  schedules    ProfessionalSchedule[]
  appointments Appointment[]
  blockedSlots BlockedSlot[]
  procedures   Procedure[]            @relation("ProcedureProfessionals")
  evolutions   Evolution[]
  quotes       Quote[]

  @@index([tenantId])
  @@map("professionals")
}

model ProfessionalSchedule {
  id             String  @id @default(cuid())
  professionalId String
  dayOfWeek      Int
  startTime      String
  endTime        String
  lunchStart     String?
  lunchEnd       String?

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, dayOfWeek])
  @@map("professional_schedules")
}

model ProcedureCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  color     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  procedures Procedure[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("procedure_categories")
}

model Procedure {
  id                 String   @id @default(cuid())
  tenantId           String
  categoryId         String?
  name               String
  description        String?
  basePrice          Decimal  @db.Decimal(10, 2)
  durationMinutes    Int
  prepTimeMinutes    Int?
  color              String?
  internalCode       String?
  materials          String?
  allowsDiscount     Boolean  @default(false)
  maxDiscountPercent Decimal? @db.Decimal(5, 2)

  /// De quantos em quantos dias este procedimento se repete.
  ///
  /// Nulo quando não se repete: restauração, endodontia e implante são feitos
  /// uma vez e acabou. Limpeza volta a cada 6 meses, manutenção de aparelho
  /// todo mês — é isso que diz quando o paciente está "vencido" para voltar.
  recurrenceIntervalDays Int?
  /// Quantos dias além do vencimento ainda contam como normal. Passou disso, a
  /// pessoa está atrasada de verdade.
  recurrenceGraceDays    Int? @default(120)

  active             Boolean  @default(true)
  deletedAt          DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  category      ProcedureCategory? @relation(fields: [categoryId], references: [id])
  professionals Professional[]     @relation("ProcedureProfessionals")
  appointments  Appointment[]
  quoteItems    QuoteItem[]
  interestedLeads Lead[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
  @@index([tenantId, categoryId])
  @@map("procedures")
}

model Appointment {
  id             String            @id @default(cuid())
  tenantId       String
  patientId      String
  professionalId String
  procedureId    String?
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus @default(SCHEDULED)
  type           AppointmentType   @default(PARTICULAR)
  notes          String?
  cancelReason   String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  patient      Patient           @relation(fields: [patientId], references: [id])
  professional Professional      @relation(fields: [professionalId], references: [id])
  procedure    Procedure?        @relation(fields: [procedureId], references: [id])
  messages     WhatsAppMessage[]

  @@index([tenantId, professionalId, startTime])
  @@index([tenantId, startTime])
  @@index([tenantId, status])
  @@map("appointments")
}

model BlockedSlot {
  id             String   @id @default(cuid())
  tenantId       String
  professionalId String
  startTime      DateTime
  endTime        DateTime
  reason         String?
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([tenantId, professionalId, startTime])
  @@map("blocked_slots")
}

model Quote {
  id            String       @id @default(cuid())
  tenantId      String
  patientId     String
  number        Int
  publicToken   String       @unique
  status        QuoteStatus  @default(DRAFT)
  discountType  DiscountType @default(PERCENT)
  discountValue Decimal      @default(0) @db.Decimal(10, 2)
  subtotal      Decimal      @db.Decimal(10, 2)
  total         Decimal      @db.Decimal(10, 2)
  notes         String?
  internalNotes String?
  validUntil    DateTime
  sentAt        DateTime?
  viewedAt      DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  rejectReason  String?
  pdfUrl        String?

  /// Quem vai executar o tratamento. Sai no orçamento e no contrato.
  professionalId String?
  /// Condições de pagamento. `installments` conta as parcelas do saldo, depois
  /// da entrada; entrada igual ao total é pagamento à vista. Método nulo = a
  /// combinar. Ver `lib/payment-terms.ts`.
  paymentMethod  String?
  downPayment    Decimal @default(0) @db.Decimal(10, 2)
  installments   Int     @default(1)

  createdById   String?
  updatedById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  patient      Patient           @relation(fields: [patientId], references: [id])
  professional Professional?     @relation(fields: [professionalId], references: [id])
  items        QuoteItem[]
  messages WhatsAppMessage[]
  payments Payment[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("quotes")
}

model QuoteItem {
  id              String   @id @default(cuid())
  quoteId         String
  procedureId     String?
  name            String
  description     String?
  unitPrice       Decimal  @db.Decimal(10, 2)
  quantity        Int      @default(1)
  discountPercent Decimal? @default(0) @db.Decimal(5, 2)
  total           Decimal  @db.Decimal(10, 2)

  quote     Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  procedure Procedure? @relation(fields: [procedureId], references: [id])

  @@index([quoteId])
  @@map("quote_items")
}

model WhatsAppMessage {
  id            String           @id @default(cuid())
  tenantId      String
  patientId     String
  appointmentId String?
  quoteId       String?
  direction     MessageDirection
  templateName  String?
  content       String
  status        MessageStatus    @default(PENDING)

  /// WhatsApp's own id for the message. Doubles as the "this was really handed
  /// to WhatsApp" marker: the gateway stamps it the moment the socket accepts,
  /// so a retry can tell an unsent row from one whose HTTP reply we simply lost.
  externalId    String?

  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  errorMessage  String?
  createdAt     DateTime         @default(now())

  /// Outbox bookkeeping. The row is written *before* the first attempt, so a
  /// crash, a timeout or a redeploy mid-send leaves something to retry instead
  /// of a patient who was never told and a clinic that never found out.
  attempts      Int              @default(0)
  lastAttemptAt DateTime?
  /// When the next attempt becomes due. Null once the row is settled — either
  /// handed to WhatsApp or failed for a reason no retry would fix.
  nextAttemptAt DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  quote       Quote?       @relation(fields: [quoteId], references: [id])

  @@index([tenantId, appointmentId])
  @@index([tenantId, patientId, createdAt(sort: Desc)])
  @@index([externalId])
  /// Drives the gateway's retry scan, which runs on a timer against every tenant.
  @@index([status, nextAttemptAt])
  @@map("whatsapp_messages")
}

model ToothRecord {
  id          String      @id @default(cuid())
  tenantId    String
  patientId   String
  toothNumber Int
  status      ToothStatus
  note        String?
  updatedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@unique([patientId, toothNumber])
  @@index([tenantId, patientId])
  @@map("tooth_records")
}

/** Health questionnaire (one per patient). Answers stored as JSON:
 *  { items: { [key]: { value: 'yes'|'no', detail?: string } }, obs?: string } */
model Anamnesis {
  id          String   @id @default(cuid())
  tenantId    String
  patientId   String   @unique
  answers     Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId])
  @@map("anamneses")
}

/** Clinical evolution entry — what was done in a visit/session. */
model Evolution {
  id             String   @id @default(cuid())
  tenantId       String
  patientId      String
  professionalId String?
  description    String
  teeth          Int[]    @default([])
  createdById    String?
  createdAt      DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@index([tenantId, patientId, createdAt(sort: Desc)])
  @@map("evolutions")
}

/** Image/document attached to a patient (stored in Supabase Storage). */
model PatientFile {
  id          String   @id @default(cuid())
  tenantId    String
  patientId   String
  bucketPath  String
  filename    String
  mimeType    String
  sizeBytes   Int
  description String?
  createdById String?
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId, createdAt(sort: Desc)])
  @@map("patient_files")
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  patientId   String
  quoteId     String?
  amount      Decimal  @db.Decimal(10, 2)
  method      String?
  notes       String?
  paidAt      DateTime @default(now())
  createdById String?
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  @@index([tenantId, patientId, paidAt(sort: Desc)])
  @@map("payments")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Lifecycle of a clinic's own WhatsApp line, paired over the WhatsApp Web
/// protocol (QR code). One line per tenant.
enum WhatsAppConnectionStatus {
  DISCONNECTED
  CONNECTING
  QR_PENDING
  CONNECTED
  ERROR
}

model WhatsAppSession {
  id       String                   @id @default(cuid())
  tenantId String                   @unique
  status   WhatsAppConnectionStatus @default(DISCONNECTED)

  /// Number the clinic paired, in E.164 digits (no mask). Filled on connect.
  phoneNumber String?
  displayName String?

  /// Short-lived pairing payload. Cleared as soon as the socket is open.
  qrCode      String?
  qrExpiresAt DateTime?

  lastError      String?
  connectedAt    DateTime?
  disconnectedAt DateTime?

  /// Which automations this clinic wants on its own line.
  notifyOnCreate  Boolean @default(true)
  notifyReminder  Boolean @default(true)
  notifyBirthday  Boolean @default(false)
  /// Textos escolhidos pela clínica. Nulo = usa o texto padrão do sistema.
  /// Aceitam {nome}, {clinica}, {data}, {hora}, {profissional} e {procedimento}.
  birthdayMessage String?
  createdMessage  String?
  reminderMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([status])
  @@map("whatsapp_sessions")
}

/// Baileys credential store. One row per (tenant, key); values are encrypted
/// with the tenant-scoped master key, never logged.
model WhatsAppAuthKey {
  id       String @id @default(cuid())
  tenantId String
  key      String
  value    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("whatsapp_auth_keys")
}

/// Liveness beacon written by the WhatsApp gateway. Single row: the gateway
/// stamps it on boot and refreshes it periodically, so the app (and whoever is
/// debugging a deploy) can tell whether the always-on service is really alive
/// and which port it bound — without shell access to the host.
model GatewayHeartbeat {
  id       String   @id @default("gateway")
  bootedAt DateTime @default(now())
  beatAt   DateTime @updatedAt
  port     Int
  note     String?

  @@map("gateway_heartbeat")
}

enum CampaignStatus {
  DRAFT
  SENDING
  DONE
  CANCELLED
}

/// A bulk WhatsApp send (promotions, recalls, seasonal greetings). Delivery is
/// paced by the gateway rather than fired at once: a burst from a QR-paired
/// number is what gets a clinic's line banned.
model Campaign {
  id       String         @id @default(cuid())
  tenantId String
  name     String
  message  String
  status   CampaignStatus @default(DRAFT)

  total  Int @default(0)
  sent   Int @default(0)
  failed Int @default(0)

  createdById String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  recipients CampaignRecipient[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String        @id @default(cuid())
  tenantId   String
  campaignId String
  patientId  String
  status     MessageStatus @default(PENDING)
  error      String?
  sentAt     DateTime?
  createdAt  DateTime      @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  patient  Patient  @relation(fields: [patientId], references: [id])

  @@unique([campaignId, patientId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// ─── Assinatura (cobrança do ClinicaIQ pelas clínicas) ───────────────────────
// Distinto de `Payment`, que é o dinheiro que o *paciente* paga para a clínica.

enum PlanTier {
  ESSENCIAL
  PROFISSIONAL
  CLINICA
}

enum SubscriptionStatus {
  TRIALING // avaliação gratuita, acesso total
  ACTIVE // em dia
  PAST_DUE // venceu, dentro da tolerância — ainda acessa
  SUSPENDED // tolerância esgotada — somente leitura
  CANCELLED // encerrada a pedido da clínica
}

enum ChargeStatus {
  PENDING
  PAID
  OVERDUE
  REFUNDED
  CANCELLED
}

/// Um plano vendável. Os limites moram aqui, e não no código, para que mudar
/// preço ou liberar um recurso não exija deploy.
model Plan {
  tier              PlanTier @id
  name              String
  description       String
  monthlyPriceCents Int
  /// Teto de profissionais; null = ilimitado.
  maxProfessionals  Int?
  whatsappEnabled   Boolean  @default(true)
  campaignsEnabled  Boolean  @default(false)
  assistantEnabled  Boolean  @default(false)
  advancedReports   Boolean  @default(false)
  /// Preço do CRM por usuário com acesso, por mês. O CRM é um adicional pago
  /// por cima de qualquer plano (docs/superpowers/specs/2026-10-09-crm-adicional-pago-design.md).
  crmSeatPriceCents Int      @default(3900)
  /// Ordem de exibição na tela de planos.
  sortOrder         Int      @default(0)
  active            Boolean  @default(true)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id       String   @id @default(cuid())
  tenantId String   @unique
  tier     PlanTier

  status SubscriptionStatus @default(TRIALING)

  trialEndsAt        DateTime?
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  /// Fim da tolerância após o vencimento. Passou disso, vira SUSPENDED.
  graceEndsAt        DateTime?
  cancelledAt        DateTime?

  /// Cortesia: acesso completo e nenhuma cobrança, concedida por nós.
  ///
  /// Bandeira à parte, e não mais um valor de `status`, de propósito: o status
  /// é reescrito pela reconciliação e pelo webhook do Asaas a partir das datas,
  /// e uma cortesia não pode depender de nenhum dos dois lembrar que ela existe.
  /// `resolveAccess` olha para cá antes de qualquer data.
  complimentary     Boolean @default(false)
  /// Por que foi concedida — para quem ler a tabela daqui a um ano.
  complimentaryNote String?

  /// Identificadores no Asaas. Nulos enquanto a cobrança for manual.
  asaasCustomerId     String?
  asaasSubscriptionId String?

  /// Módulo CRM contratado. Desligado por padrão: clínica sem CRM não vê
  /// nada novo e a automação do funil não faz nada para ela.
  crmEnabled Boolean @default(false)
  /// Fim dos 14 dias grátis do CRM. Preenchido também marca que o teste já foi
  /// usado: ligar e desligar não dá um teste novo.
  crmTrialEndsAt   DateTime?
  /// Último valor mensal enviado ao Asaas (plano + CRM). Só se manda de novo
  /// quando o cálculo der diferente — a rotina diária pode rodar à vontade.
  billedValueCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  plan    Plan     @relation(fields: [tier], references: [tier])
  charges Charge[]

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

/// Uma fatura. Guardamos os links do Asaas para a clínica pagar sem sair do
/// sistema — o boleto e o QR do PIX são o que ela realmente precisa.
model Charge {
  id             String       @id @default(cuid())
  tenantId       String
  subscriptionId String
  amountCents    Int
  status         ChargeStatus @default(PENDING)
  dueDate        DateTime
  paidAt         DateTime?

  asaasChargeId String? @unique
  invoiceUrl    String?
  bankSlipUrl   String?
  pixPayload    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, dueDate(sort: Desc)])
  @@map("charges")
}

/// Convite para alguém entrar numa clínica que já existe.
///
/// O Clerk manda o e-mail e a pessoa define a própria senha no cadastro — o que
/// guardamos aqui é a intenção: quem foi convidado, para qual clínica e com qual
/// perfil. Guardar do nosso lado também é o que faz o vínculo funcionar mesmo se
/// o metadata do convite não chegar ao usuário: no onboarding procuramos um
/// convite pendente para o e-mail já verificado pelo Clerk.
model Invitation {
  id                String           @id @default(cuid())
  tenantId          String
  /// Sempre em minúsculas — é a chave de busca no onboarding.
  email             String
  role              Role
  status            InvitationStatus @default(PENDING)
  /// Id do convite no Clerk, para conseguir revogar lá também.
  clerkInvitationId String?
  invitedById       String?
  createdAt         DateTime         @default(now())
  acceptedAt        DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Um convite pendente por e-mail por clínica. Reconvidar atualiza o que existe.
  @@unique([tenantId, email])
  @@index([email, status])
  @@map("invitations")
}

// ─── CRM ────────────────────────────────────────────────────────────────────
//
// Captação de pacientes no estilo Kommo. O lead é um negócio, não a pessoa: a
// mesma pessoa pode ter vários ao longo do tempo ("Implante" hoje,
// "Harmonização" ano que vem). Enquanto não é paciente, o contato mora no
// próprio lead; depois de convertido, `patientId` aponta para a ficha.
//
// Toda tabela daqui tem `tenantId`, inclusive as de ligação: `getTenantClient`
// filtra todo modelo por ele, e uma tabela sem a coluna quebraria as consultas.
// Ver docs/superpowers/specs/2026-10-07-crm-etapa1-leads-funil-design.md.

/// Papel de uma etapa para a automação. A automação procura a etapa pelo
/// papel, nunca pelo nome — assim a clínica renomeia à vontade.
enum StageRole {
  NEW
  SCHEDULED
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WHATSAPP
  INDICACAO
  INSTAGRAM
  SITE
  MANUAL
  OUTRO
}

enum LeadActivityType {
  CREATED
  STAGE_CHANGED
  NOTE
  TAG_ADDED
  TAG_REMOVED
  ASSIGNED
  TASK_CREATED
  TASK_COMPLETED
  CONVERTED
  LOST
  REOPENED
  /// Algo que aconteceu na agenda ou nos orçamentos do paciente ligado.
  CLINIC_EVENT
}

enum TaskOrigin {
  MANUAL
  /// Criada pela integração com a agenda e os orçamentos (ex.: "Reagendar avaliação").
  AUTOMATION
}

model Lead {
  id       String @id @default(cuid())
  tenantId String

  /// Nome do negócio ("Implante"). Vazio: a tela mostra o interesse ou o nome.
  title          String?
  /// Nome da pessoa. Copiado do paciente quando o lead é ligado a um.
  name           String
  phoneEncrypted String  @map("phone")
  /// HMAC do telefone normalizado com a chave da clínica. Serve só para achar
  /// lead duplicado sem decifrar todos os telefones.
  phoneHash      String
  email          String?

  stageId        String
  /// Ordem dentro da coluna do quadro.
  position       Int      @default(0)
  /// Quando entrou na etapa atual — o card mostra "há 3 dias".
  stageEnteredAt DateTime @default(now())

  assignedToId        String?
  source              LeadSource @default(MANUAL)
  interestProcedureId String?
  estimatedValueCents Int?
  notes               String?

  /// Pediu para não receber mais mensagens (respondeu SAIR). Transmissões e
  /// automações pulam; a conversa continua.
  whatsappOptOut Boolean @default(false)

  /// Paciente ligado. Não é único de propósito: vários negócios por pessoa.
  patientId    String?
  lostReasonId String?

  /// Lead "aberto" = os três nulos.
  wonAt     DateTime?
  lostAt    DateTime?
  deletedAt DateTime?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  stage             PipelineStage   @relation(fields: [stageId], references: [id])
  assignedTo        User?           @relation("LeadAssignee", fields: [assignedToId], references: [id])
  interestProcedure Procedure?      @relation(fields: [interestProcedureId], references: [id])
  patient           Patient?        @relation(fields: [patientId], references: [id])
  lostReason        LostReason?     @relation(fields: [lostReasonId], references: [id])
  tasks             LeadTask[]
  tags              LeadTagOnLead[]
  activities        LeadActivity[]
  conversations     Conversation[]
  broadcastRecipients BroadcastRecipient[]
  automationRuns    AutomationRun[]

  @@index([tenantId, stageId, position])
  @@index([tenantId, phoneHash])
  @@index([tenantId, patientId])
  @@index([tenantId, assignedToId])
  @@index([tenantId, deletedAt])
  @@map("leads")
}

model PipelineStage {
  id       String     @id @default(cuid())
  tenantId String
  name     String
  /// Nome de um token da paleta do app, não um hex livre.
  color    String
  order    Int
  /// Null = etapa criada pela clínica, que a automação não conhece.
  role     StageRole?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  leads       Lead[]
  automations StageAutomation[]

  /// Cada papel no máximo uma vez por clínica. No Postgres nulos não colidem
  /// num índice único, então as etapas sem papel ficam livres.
  @@unique([tenantId, role])
  @@index([tenantId, order])
  @@map("pipeline_stages")
}

model LeadTask {
  id       String @id @default(cuid())
  tenantId String
  leadId   String

  text          String
  dueAt         DateTime
  assignedToId  String
  completedAt   DateTime?
  completedById String?
  origin        TaskOrigin @default(MANUAL)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  lead       Lead   @relation(fields: [leadId], references: [id])
  assignedTo User   @relation("LeadTaskAssignee", fields: [assignedToId], references: [id])

  @@index([tenantId, leadId, completedAt])
  /// "Minhas tarefas": pendentes de uma pessoa, por vencimento.
  @@index([tenantId, assignedToId, completedAt, dueAt])
  @@map("lead_tasks")
}

model LeadTag {
  id       String @id @default(cuid())
  tenantId String
  name     String
  color    String

  createdAt DateTime @default(now())

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  leads  LeadTagOnLead[]

  @@unique([tenantId, name])
  @@map("lead_tags")
}

model LeadTagOnLead {
  tenantId String
  leadId   String
  tagId    String

  createdAt DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  lead   Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    LeadTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tenantId, tagId])
  @@map("lead_tags_on_leads")
}

model LostReason {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  order    Int
  active   Boolean @default(true)

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  leads  Lead[]

  @@unique([tenantId, name])
  @@map("lost_reasons")
}

model LeadActivity {
  id       String           @id @default(cuid())
  tenantId String
  leadId   String
  type     LeadActivityType
  /// Detalhe do evento (ex.: { from, to }, { tagId }, { appointmentId }).
  /// Nunca telefone nem outro dado pessoal.
  data     Json?
  /// Null = foi a automação.
  actorId  String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  lead   Lead   @relation(fields: [leadId], references: [id])

  @@index([tenantId, leadId, createdAt(sort: Desc)])
  @@map("lead_activities")
}

// ─── CRM etapa 2: conversas do WhatsApp ──────────────────────────────────────

enum ConversationStatus {
  /// Número que ninguém conhece ainda: espera alguém aceitar ou recusar.
  INBOX
  ACTIVE
  /// Recusada na Entrada. Volta para a Entrada se a pessoa escrever de novo.
  DECLINED
}

enum ChatOrigin {
  /// Escrita pelo contato.
  CONTACT
  /// Escrita no CRM por alguém da equipe.
  CRM
  /// Escrita no celular (ou WhatsApp Web) da clínica.
  PHONE
  /// Lembrete, confirmação ou campanha do sistema.
  AUTOMATION
  /// Transmissão do CRM.
  BROADCAST
  /// Robô ou automação por etapa do CRM.
  BOT
}

enum ChatKind {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
  OTHER
}

/// Um número de WhatsApp = uma conversa, como no celular. Gravada pelo gateway
/// só para clínicas com o CRM ligado.
model Conversation {
  id       String @id @default(cuid())
  tenantId String

  phoneEncrypted String  @map("phone")
  /// Índice cego da chave de conversa (telefone normalizado, celular sempre com
  /// o 9). Gateway e app calculam igual — ver `chatKey`.
  phoneHash      String
  /// O nome que a pessoa usa no WhatsApp.
  contactName    String?

  status       ConversationStatus @default(INBOX)
  leadId       String?
  patientId    String?
  /// Quando o app já tentou ligar a lead ou paciente. Nulo = falta tentar.
  classifiedAt DateTime?

  unreadCount          Int      @default(0)
  /// A última palavra é do contato: ninguém da clínica respondeu ainda.
  awaitingReply        Boolean  @default(false)
  lastMessageAt        DateTime @default(now())
  /// Começo da última mensagem, cifrado (é conversa de clínica).
  lastPreviewEncrypted String?  @map("lastPreview")
  /// Última mensagem do contato. Na API oficial, define a janela de 24 horas.
  lastInboundAt        DateTime?

  /// Robô ativo nesta conversa (nulo = nenhum).
  botFlowId    String?
  botStepId    String?
  botStartedAt DateTime?
  /// Respostas que o robô não entendeu seguidas; na segunda, passa para a equipe.
  botMisses    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  lead     Lead?         @relation(fields: [leadId], references: [id])
  patient  Patient?      @relation(fields: [patientId], references: [id])
  botFlow  ChatbotFlow?  @relation(fields: [botFlowId], references: [id], onDelete: SetNull)
  messages ChatMessage[]
  broadcastRecipients BroadcastRecipient[]

  @@unique([tenantId, phoneHash])
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@index([tenantId, status, lastMessageAt(sort: Desc)])
  @@index([tenantId, leadId])
  @@map("conversations")
}

model ChatMessage {
  id             String @id @default(cuid())
  tenantId       String
  conversationId String

  direction     MessageDirection
  origin        ChatOrigin
  kind          ChatKind      @default(TEXT)
  /// Texto ou legenda, cifrado. Nulo em mídia sem legenda.
  textEncrypted String?       @map("text")
  /// Id da mensagem no WhatsApp. Único por clínica: é o que impede gravar duas
  /// vezes a mesma mensagem (o gateway vê a própria saída de volta).
  externalId    String
  status        MessageStatus @default(SENT)
  /// Quem escreveu, quando foi pelo CRM.
  sentById      String?
  /// Hora da mensagem no WhatsApp.
  at            DateTime      @default(now())

  /// Modelo aprovado usado (API oficial).
  templateName  String?
  /// Mídia na API oficial: id na Meta, buscado sob demanda (nada é guardado).
  mediaRef      String?
  mimeType      String?
  /// Opções do robô: [{ id, title }]. Botões na API oficial; no QR o texto já
  /// traz as opções numeradas.
  buttons       Json?

  /// Fila do envio pelo CRM. `acceptedAt` = o WhatsApp aceitou; daí em diante
  /// quem manda no status são os acks.
  acceptedAt    DateTime?
  attempts      Int           @default(0)
  nextAttemptAt DateTime?
  /// Reserva de quem está enviando agora, para o envio direto e a rotina de
  /// reenvio não mandarem a mesma linha ao mesmo tempo.
  claimedUntil  DateTime?
  errorMessage  String?

  createdAt DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])
  sentBy       User?        @relation(fields: [sentById], references: [id])
  broadcastRecipient BroadcastRecipient?

  @@unique([tenantId, externalId])
  @@index([tenantId, conversationId, at])
  /// A rotina de reenvio do gateway.
  @@index([status, nextAttemptAt])
  @@map("chat_messages")
}

/// Respostas prontas da clínica, chamadas com "/" na caixa de texto.
model QuickReply {
  id       String @id @default(cuid())
  tenantId String
  /// O atalho ("horarios"). Único na clínica.
  title    String
  /// O texto. Aceita {nome}.
  body     String
  order    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, title])
  @@map("quick_replies")
}

// ─── CRM: API oficial, transmissões, robô e automações ──────────────────────

enum CloudAccountStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

/// A conta da clínica na API oficial do WhatsApp (Cloud API da Meta). Ativa e
/// conectada, ela é o canal das conversas do CRM no lugar do gateway de QR.
model WhatsAppCloudAccount {
  id       String @id @default(cuid())
  tenantId String @unique

  wabaId        String
  /// Único no sistema: é por ele que o webhook da Meta descobre a clínica.
  phoneNumberId String  @unique
  displayPhone  String?
  verifiedName  String?
  /// Token de acesso, cifrado com a chave da clínica. Nunca vai para a tela.
  accessTokenEncrypted String @map("accessToken")
  /// O número continua no app WhatsApp Business do celular (coexistência).
  coexistence Boolean @default(false)
  /// Conectada pelo formulário de teste (número de teste da Meta).
  manual      Boolean @default(false)
  active      Boolean @default(true)
  status      CloudAccountStatus @default(CONNECTED)
  lastError   String?
  connectedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("whatsapp_cloud_accounts")
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  APPROVED
  PENDING
  REJECTED
  PAUSED
  DISABLED
}

/// Modelo de mensagem aprovado pela Meta. Fora da janela de 24 horas, é o único
/// jeito de escrever pela API oficial.
model MessageTemplate {
  id       String @id @default(cuid())
  tenantId String

  name           String
  language       String           @default("pt_BR")
  category       TemplateCategory
  status         TemplateStatus   @default(PENDING)
  /// Texto do corpo, com {{1}}, {{2}}…
  body           String
  variables      Int              @default(0)
  components     Json?
  externalId     String?
  rejectedReason String?
  lastSyncedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  broadcasts Broadcast[]

  @@unique([tenantId, name, language])
  @@map("message_templates")
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  DONE
  CANCELLED
}

enum BroadcastRecipientStatus {
  /// Mensagem criada na fila (o andamento está na própria mensagem).
  QUEUED
  /// Não recebe: pediu para sair, sem telefone válido…
  SKIPPED
  CANCELLED
}

/// Transmissão do CRM para um grupo de leads.
model Broadcast {
  id       String          @id @default(cuid())
  tenantId String
  name     String
  status   BroadcastStatus @default(DRAFT)

  /// Mensagem livre (gateway de QR). Aceita {nome}.
  text           String?
  /// Modelo aprovado (API oficial).
  templateId     String?
  /// Valor de cada variável do modelo, em ordem: texto fixo ou "{nome}".
  templateParams Json?
  /// Quem recebe: { stageIds, tagIds, sources, assignedToIds }.
  audience       Json

  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  cancelledAt DateTime?
  total       Int       @default(0)
  skipped     Int       @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant               @relation(fields: [tenantId], references: [id])
  template   MessageTemplate?     @relation(fields: [templateId], references: [id])
  recipients BroadcastRecipient[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status, scheduledAt])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id             String                   @id @default(cuid())
  tenantId       String
  broadcastId    String
  leadId         String
  conversationId String?
  chatMessageId  String?                  @unique
  status         BroadcastRecipientStatus @default(QUEUED)
  skipReason     String?

  createdAt DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  broadcast    Broadcast     @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  lead         Lead          @relation(fields: [leadId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  chatMessage  ChatMessage?  @relation(fields: [chatMessageId], references: [id], onDelete: SetNull)

  @@unique([broadcastId, leadId])
  @@index([tenantId, broadcastId])
  @@map("broadcast_recipients")
}

enum AutomationAction {
  SEND_MESSAGE
  CREATE_TASK
  ADD_TAG
  ASSIGN_USER
}

enum AutomationRunStatus {
  PENDING
  DONE
  SKIPPED
  FAILED
}

/// O que acontece quando um lead entra numa etapa (o "funil digital" do Kommo).
model StageAutomation {
  id       String           @id @default(cuid())
  tenantId String
  stageId  String
  action   AutomationAction
  /// SEND_MESSAGE { text } ou { templateId, params } · CREATE_TASK { text, dueHours,
  /// assignTo: "responsible" | userId } · ADD_TAG { tagId } · ASSIGN_USER { userId }
  config       Json
  delayMinutes Int     @default(0)
  active       Boolean @default(true)
  order        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  stage  PipelineStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  runs   AutomationRun[]

  @@index([tenantId, stageId])
  @@map("stage_automations")
}

model AutomationRun {
  id           String              @id @default(cuid())
  tenantId     String
  automationId String
  leadId       String
  dueAt        DateTime
  /// A entrada na etapa que disparou. Se o lead saiu e voltou, é outra execução.
  stageEnteredAt DateTime
  status       AutomationRunStatus @default(PENDING)
  error        String?
  doneAt       DateTime?

  createdAt DateTime @default(now())

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  automation StageAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  lead       Lead            @relation(fields: [leadId], references: [id])

  @@index([status, dueAt])
  @@index([tenantId, leadId])
  @@map("automation_runs")
}

enum ChatbotTrigger {
  /// Primeira mensagem de um número que ninguém conhece.
  NEW_CONTACT
  /// A mensagem é uma das palavras-chave.
  KEYWORD
}

/// Robô por botões: um menu, com submenus, respostas e ações.
model ChatbotFlow {
  id       String         @id @default(cuid())
  tenantId String
  name     String
  active   Boolean        @default(false)
  trigger  ChatbotTrigger
  keywords String[]       @default([])
  /// { start, steps: { [id]: { text, options: [{ id, label, reply?, next?, actions? }] } } }
  steps    Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  conversations Conversation[]

  @@index([tenantId, active])
  @@map("chatbot_flows")
}
